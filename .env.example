# Salin ke .env dan isi. JANGAN commit .env. Semua nilai di bawah = PLACEHOLDER.

# Inti
NODE_ENV=development
PORT=3000
DB_PATH=./services/api/data/nena.db
SESSION_SECRET=ganti-dengan-string-acak-min-16-char
ENCRYPTION_KEY=ganti-64-hex-char-32-byte-buat-dengan-crypto-randomBytes-32
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ganti-password-owner

# Email notifikasi (Gmail SMTP + App Password — dibuat oleh owner, lihat NOTIFICATIONS.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alamat-gmail-anda@gmail.com
SMTP_PASS=app-password-16-karakter-tanpa-spasi
MAIL_FROM=alamat-gmail-anda@gmail.com
MAIL_FROM_NAME=Nena Adventure

# Gerbang keamanan notifikasi
# NOTIFY_MODE: off (tak kirim) | dryrun (render+catat, tak kirim) | live (kirim beneran)
NOTIFY_MODE=dryrun
# Alihkan SEMUA email ke satu alamat saat uji (kosongkan untuk kirim ke penerima asli)
NOTIFY_REDIRECT_TO=email-uji-anda@example.com
# Batas kirim per jam
NOTIFY_MAX_PER_HOUR=60
